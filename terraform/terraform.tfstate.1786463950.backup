            "policy": "{\"rules\":[{\"action\":{\"type\":\"expire\"},\"description\":\"Remove untagged images older than 5 days\",\"rulePriority\":1,\"selection\":{\"countNumber\":5,\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"tagStatus\":\"untagged\"}},{\"action\":{\"type\":\"expire\"},\"description\":\"Keep only the last 5 tagged images\",\"rulePriority\":2,\"selection\":{\"countNumber\":5,\"countType\":\"imageCountMoreThan\",\"tagPrefixList\":[\"v\",\"latest\"],\"tagStatus\":\"tagged\"}}]}",
